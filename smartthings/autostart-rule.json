{
  "name": "TinkerSpace autostart",
  "actions": [{
    "if": {
      "changes": {
        "equals": {
          "left": {"device": {"devices": ["<TV_DEVICE_ID>"], "component": "main", "capability": "switch", "attribute": "switch"}},
          "right": {"string": "on"}
        }
      },
      "then": [
        {"sleep": {"duration": {"value": {"integer": 20}, "unit": "Second"}}},
        {"command": {"devices": ["<TV_DEVICE_ID>"], "commands": [{"component": "main", "capability": "custom.launchapp", "command": "launchApp", "arguments": [{"string": "TnkSpace01.TinkerSpace"}]}]}}
      ]
    }
  }]
}
